{
  "name": "school_calendar",
  "version": "1.0.0",
  "description": "Google Apps Script project to manage school events, timetables, and items to bring",
  "scripts": {
    "login": "clasp login",
    "login:status": "clasp login --status",
    "logout": "clasp logout",
    "build": "rm -rf dist && tsc && cp src/appsscript.json src/*.html dist/",
    "push": "npm run build && clasp push -f",
    "push:force": "npm run build && clasp push -f",
    "pull": "clasp pull && cp dist/appsscript.json src/",
    "open": "clasp open-script",
    "open:webapp": "clasp open-web-app",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "google-apps-script",
    "clasp",
    "calendar",
    "school"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.15",
    "typescript": "^7.0.2"
  }
}
